// Get single purchase order with items
app.get('/api/purchase-orders/:id', async (req, res) => {
    const { id } = req.params;
    try {
        const poResult = await pool.query(`
            SELECT po.*, s.name as supplier_name, s.contact_name, s.phone, s.email
            FROM purchase_orders po
            LEFT JOIN suppliers s ON po.supplier_id = s.id
            WHERE po.id = $1
        `, [id]);
        
        if (poResult.rows.length === 0) {
            return res.status(404).json({ error: 'Purchase order not found' });
        }
        
        const itemsResult = await pool.query(`
            SELECT poi.*, sp.part_number, sp.name as part_name, sp.unit_price as current_price
            FROM purchase_order_items poi
            JOIN spare_parts sp ON poi.spare_part_id = sp.id
            WHERE poi.purchase_order_id = $1
        `, [id]);
        
        res.json({
            purchase_order: poResult.rows[0],
            items: itemsResult.rows
        });
    } catch (err) {
        res.status(500).json({ error: err.message });
    }
});

// Create purchase order
app.post('/api/purchase-orders', async (req, res) => {
    const { po_number, supplier_id, order_date, expected_date, notes, items } = req.body;
    const client = await pool.connect();
    try {
        await client.query('BEGIN');
        
        let subtotal = 0;
        for (const item of items) {
            subtotal += item.quantity_ordered * item.unit_price;
        }
        const total = subtotal;
        
        const poResult = await client.query(
            `INSERT INTO purchase_orders (po_number, supplier_id, order_date, expected_date, subtotal, total, notes, status)
             VALUES ($1, $2, $3, $4, $5, $6, $7, 'pending') RETURNING *`,
            [po_number, supplier_id, order_date, expected_date, subtotal, total, notes]
        );
        
        const poId = poResult.rows[0].id;
        
        for (const item of items) {
            await client.query(
                `INSERT INTO purchase_order_items (purchase_order_id, spare_part_id, quantity_ordered, unit_price, total)
                 VALUES ($1, $2, $3, $4, $5)`,
                [poId, item.spare_part_id, item.quantity_ordered, item.unit_price, item.quantity_ordered * item.unit_price]
            );
        }
        
        await client.query('COMMIT');
        res.json(poResult.rows[0]);
    } catch (err) {
        await client.query('ROLLBACK');
        res.status(500).json({ error: err.message });
    } finally {
        client.release();
    }
});

// Receive purchase order (update stock)
app.post('/api/purchase-orders/:id/receive', async (req, res) => {
    const { id } = req.params;
    const { received_date, items } = req.body;
    const client = await pool.connect();
    try {
        await client.query('BEGIN');
        
        for (const item of items) {
            if (item.quantity_received > 0) {
                await client.query(
                    `UPDATE purchase_order_items 
                     SET quantity_received = quantity_received + $1
                     WHERE id = $2`,
                    [item.quantity_received, item.id]
                );
                
                await client.query(
                    `UPDATE spare_parts 
                     SET stock_quantity = stock_quantity + $1,
                         last_restocked = $2
                     WHERE id = $3`,
                    [item.quantity_received, received_date, item.spare_part_id]
                );
                
                await client.query(
                    `INSERT INTO inventory_movements (part_id, type, quantity, reason, work_order_id)
                     VALUES ($1, 'in', $2, $3, NULL)`,
                    [item.spare_part_id, item.quantity_received, `Purchase Order #${id} received`]
                );
            }
        }
        
        await client.query(
            `UPDATE purchase_orders SET status = 'received', received_date = $1 WHERE id = $2`,
            [received_date, id]
        );
        
        await client.query('COMMIT');
        res.json({ success: true });
    } catch (err) {
        await client.query('ROLLBACK');
        res.status(500).json({ error: err.message });
    } finally {
        client.release();
    }
});

// Cancel purchase order
app.put('/api/purchase-orders/:id/cancel', async (req, res) => {
