// Add inventory movement (stock in/out)
app.post('/api/inventory-movements', async (req, res) => {
    const { part_id, type, quantity, reason, work_order_id } = req.body;
    const client = await pool.connect();
    try {
        await client.query('BEGIN');
        
        const result = await client.query(
            `INSERT INTO inventory_movements (part_id, type, quantity, reason, work_order_id)
             VALUES ($1, $2, $3, $4, $5) RETURNING *`,
            [part_id, type, quantity, reason, work_order_id]
        );
        
        if (type === 'in') {
            await client.query('UPDATE spare_parts SET stock_quantity = stock_quantity + $1 WHERE id = $2', [quantity, part_id]);
        } else if (type === 'out') {
            await client.query('UPDATE spare_parts SET stock_quantity = stock_quantity - $1 WHERE id = $2', [quantity, part_id]);
        } else {
            await client.query('UPDATE spare_parts SET stock_quantity = $1 WHERE id = $2', [quantity, part_id]);
        }
        
        await client.query('COMMIT');
        res.json(result.rows[0]);
    } catch (err) {
        await client.query('ROLLBACK');
        res.status(500).json({ error: err.message });
    } finally {
        client.release();
    }
});

