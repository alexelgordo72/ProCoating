// PDF: Financial Report
app.get('/api/reports/financial/pdf', async (req, res) => {
    const { year, month } = req.query;
    try {
        let query = `
            SELECT 
                DATE_TRUNC('month', r.start_date) as month,
                COUNT(r.id) as rental_count,
                COALESCE(SUM(r.subtotal), 0) as total_revenue,
                COALESCE(SUM(wo.internal_cost), 0) as total_internal_cost
            FROM rentals r
            LEFT JOIN work_orders wo ON wo.customer_id = r.customer_id
            WHERE r.status = 'active' OR r.status = 'completed'
        `;
        const params = [];
        
        if (year) {
            params.push(year);
            query += ` AND EXTRACT(YEAR FROM r.start_date) = $${params.length}`;
        }
        if (month) {
            params.push(month);
            query += ` AND EXTRACT(MONTH FROM r.start_date) = $${params.length}`;
        }
        query += ` GROUP BY DATE_TRUNC('month', r.start_date) ORDER BY month DESC`;
        
        const result = await pool.query(query, params);
        
        const totalRevenue = result.rows.reduce((sum, r) => sum + (parseFloat(r.total_revenue) || 0), 0);
        const totalCost = result.rows.reduce((sum, r) => sum + (parseFloat(r.total_internal_cost) || 0), 0);
        const netProfit = totalRevenue - totalCost;
        
        const docDefinition = {
            pageSize: 'LETTER',
            pageMargins: [40, 60, 40, 60],
            content: [
                { text: 'Pro-Coating Treatments Inc.', style: 'header', fontSize: 18, bold: true, alignment: 'center' },
                { text: 'Financial Report', style: 'subheader', fontSize: 14, alignment: 'center', margin: [0, 10, 0, 20] },
                {
                    table: {
                        headerRows: 1,
                        widths: ['auto', 'auto', 'auto', 'auto'],
                        body: [
                            [{ text: 'Month', style: 'tableHeader' }, { text: 'Rentals', style: 'tableHeader' }, 
                             { text: 'Revenue', style: 'tableHeader' }, { text: 'Cost', style: 'tableHeader' }],
                            ...result.rows.map(r => [
                                r.month ? new Date(r.month).toLocaleDateString('en-US', { year: 'numeric', month: 'long' }) : '-',
                                r.rental_count,
                                `$${parseFloat(r.total_revenue) || 0}`,
                                `$${parseFloat(r.total_internal_cost) || 0}`
                            ])
                        ]
                    }
                },
                { text: `\nTotal Revenue: $${totalRevenue}`, style: 'total', alignment: 'right' },
                { text: `Total Internal Cost: $${totalCost}`, style: 'total', alignment: 'right' },
                { text: `Net Profit: $${netProfit}`, style: 'total', bold: true, alignment: 'right', margin: [0, 10, 0, 0] }
            ],
            styles: {
                header: { fontSize: 18, bold: true },
                subheader: { fontSize: 14, bold: true },
                tableHeader: { bold: true, fillColor: '#f0f0f0' },
                total: { fontSize: 12 }
            }
        };
        
        const pdfDoc = printer.createPdfKitDocument(docDefinition);
        const chunks = [];
        pdfDoc.on('data', (chunk) => chunks.push(chunk));
        pdfDoc.on('end', () => {
            const pdfBuffer = Buffer.concat(chunks);
            res.setHeader('Content-Type', 'application/pdf');
            res.setHeader('Content-Disposition', 'attachment; filename=financial_report.pdf');
            res.send(pdfBuffer);
        });
        pdfDoc.end();
    } catch (err) {
        res.status(500).json({ error: err.message });
    }
});

console.log('✅ PDF Reports endpoints added');
