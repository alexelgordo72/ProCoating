// ============ REPORT: RENTALS (EXCEL) ============
app.get('/api/reports/rentals/excel', async (req, res) => {
    const { start_date, end_date } = req.query;
    try {
        let query = `
            SELECT r.rental_number, c.name as customer_name, e.model as equipment_model,
                   r.start_date, r.end_date, r.total_days, r.subtotal, r.status, r.created_at
            FROM rentals r
            JOIN customers c ON r.customer_id = c.id
            JOIN equipment e ON r.equipment_id = e.id
            WHERE 1=1
        `;
        const params = [];
        
        if (start_date) {
            params.push(start_date);
            query += ` AND r.start_date >= $${params.length}`;
        }
        if (end_date) {
            params.push(end_date);
            query += ` AND r.start_date <= $${params.length}`;
        }
        query += ` ORDER BY r.created_at DESC`;
        
        const result = await pool.query(query, params);
        
        const workbook = new ExcelJS.Workbook();
        const worksheet = workbook.addWorksheet('Rentals Report');
        
        worksheet.columns = [
            { header: 'Rental #', key: 'rental_number', width: 15 },
            { header: 'Customer', key: 'customer_name', width: 25 },
            { header: 'Equipment', key: 'equipment_model', width: 25 },
            { header: 'Start Date', key: 'start_date', width: 15 },
            { header: 'End Date', key: 'end_date', width: 15 },
            { header: 'Days', key: 'total_days', width: 10 },
            { header: 'Subtotal', key: 'subtotal', width: 15 },
            { header: 'Status', key: 'status', width: 12 },
            { header: 'Created', key: 'created_at', width: 20 }
        ];
        
        result.rows.forEach(row => {
            worksheet.addRow({
                rental_number: row.rental_number,
                customer_name: row.customer_name,
                equipment_model: row.equipment_model,
                start_date: row.start_date ? new Date(row.start_date).toLocaleDateString() : '-',
                end_date: row.end_date ? new Date(row.end_date).toLocaleDateString() : '-',
                total_days: row.total_days,
                subtotal: row.subtotal,
                status: row.status,
                created_at: new Date(row.created_at).toLocaleString()
            });
        });
        
        const total = result.rows.reduce((sum, r) => sum + (parseFloat(r.subtotal) || 0), 0);
        worksheet.addRow({});
        worksheet.addRow({ rental_number: 'TOTAL', subtotal: total });
        
        res.setHeader('Content-Type', 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet');
        res.setHeader('Content-Disposition', 'attachment; filename=rentals_report.xlsx');
        
        await workbook.xlsx.write(res);
        res.end();
    } catch (err) {
        res.status(500).json({ error: err.message });
    }
});

// ============ REPORT: WORK ORDERS (EXCEL) ============
app.get('/api/reports/workorders/excel', async (req, res) => {
    const { start_date, end_date, status } = req.query;
    try {
        let query = `
            SELECT wo.wo_number, c.name as customer_name, e.model as equipment_model,
                   wo.priority, wo.status, wo.reported_issue, wo.diagnosis, wo.solution,
                   wo.start_date, wo.end_date, wo.internal_cost, wo.is_warranty, wo.created_at
            FROM work_orders wo
            LEFT JOIN customers c ON wo.customer_id = c.id
            LEFT JOIN equipment e ON wo.equipment_id = e.id
            WHERE 1=1
        `;
        const params = [];
        
        if (start_date) {
            params.push(start_date);
            query += ` AND wo.start_date >= $${params.length}`;
        }
        if (end_date) {
            params.push(end_date);
            query += ` AND wo.start_date <= $${params.length}`;
        }
        if (status) {
            params.push(status);
            query += ` AND wo.status = $${params.length}`;
        }
        query += ` ORDER BY wo.created_at DESC`;
        
        const result = await pool.query(query, params);
        
        const workbook = new ExcelJS.Workbook();
        const worksheet = workbook.addWorksheet('Work Orders Report');
        
        worksheet.columns = [
            { header: 'WO #', key: 'wo_number', width: 15 },
            { header: 'Customer', key: 'customer_name', width: 25 },
            { header: 'Equipment', key: 'equipment_model', width: 25 },
            { header: 'Priority', key: 'priority', width: 12 },
            { header: 'Status', key: 'status', width: 15 },
            { header: 'Start Date', key: 'start_date', width: 15 },
            { header: 'End Date', key: 'end_date', width: 15 },
            { header: 'Internal Cost', key: 'internal_cost', width: 15 },
            { header: 'Warranty', key: 'is_warranty', width: 10 },
            { header: 'Created', key: 'created_at', width: 20 }
        ];
        
        result.rows.forEach(row => {
            worksheet.addRow({
                wo_number: row.wo_number,
                customer_name: row.customer_name || '-',
                equipment_model: row.equipment_model || '-',
                priority: row.priority,
                status: row.status,
                start_date: row.start_date ? new Date(row.start_date).toLocaleDateString() : '-',
                end_date: row.end_date ? new Date(row.end_date).toLocaleDateString() : '-',
                internal_cost: row.internal_cost,
                is_warranty: row.is_warranty ? 'Yes' : 'No',
                created_at: new Date(row.created_at).toLocaleString()
            });
        });
        
        const totalCost = result.rows.reduce((sum, r) => sum + (parseFloat(r.internal_cost) || 0), 0);
        worksheet.addRow({});
        worksheet.addRow({ wo_number: 'TOTAL INTERNAL COST', internal_cost: totalCost });
        
        res.setHeader('Content-Type', 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet');
        res.setHeader('Content-Disposition', 'attachment; filename=workorders_report.xlsx');
        
        await workbook.xlsx.write(res);
        res.end();
    } catch (err) {
        res.status(500).json({ error: err.message });
    }
});

// ============ REPORT: INVENTORY (EXCEL) ============
app.get('/api/reports/inventory/excel', async (req, res) => {
    try {
        const result = await pool.query(`
            SELECT part_number, name, category, location, stock_quantity, min_stock, max_stock, unit_price,
                   CASE WHEN stock_quantity <= min_stock THEN 'Low Stock' ELSE 'OK' END as stock_status,
                   created_at
            FROM spare_parts
            ORDER BY name
        `);
        
        const workbook = new ExcelJS.Workbook();
        const worksheet = workbook.addWorksheet('Inventory Report');
        
        worksheet.columns = [
            { header: 'Part #', key: 'part_number', width: 15 },
            { header: 'Name', key: 'name', width: 30 },
            { header: 'Category', key: 'category', width: 15 },
            { header: 'Location', key: 'location', width: 20 },
            { header: 'Stock', key: 'stock_quantity', width: 10 },
            { header: 'Min Stock', key: 'min_stock', width: 10 },
            { header: 'Max Stock', key: 'max_stock', width: 10 },
            { header: 'Unit Price', key: 'unit_price', width: 12 },
            { header: 'Status', key: 'stock_status', width: 12 }
        ];
        
        result.rows.forEach(row => {
            worksheet.addRow(row);
        });
        
        const lowStockCount = result.rows.filter(r => r.stock_quantity <= r.min_stock).length;
        worksheet.addRow({});
        worksheet.addRow({ part_number: 'Low Stock Items', stock_quantity: lowStockCount });
        
        res.setHeader('Content-Type', 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet');
        res.setHeader('Content-Disposition', 'attachment; filename=inventory_report.xlsx');
        
        await workbook.xlsx.write(res);
        res.end();
    } catch (err) {
        res.status(500).json({ error: err.message });
    }
});

// ============ REPORT: FINANCIAL (EXCEL) ============
app.get('/api/reports/financial/excel', async (req, res) => {
    const { year, month } = req.query;
    try {
        let query = `
            SELECT 
                DATE_TRUNC('month', r.start_date) as month,
                COUNT(r.id) as rental_count,
                COALESCE(SUM(r.subtotal), 0) as total_revenue,
                COALESCE(SUM(wo.internal_cost), 0) as total_internal_cost
            FROM rentals r
            LEFT JOIN work_orders wo ON wo.customer_id = r.customer_id
            WHERE r.status = 'active' OR r.status = 'completed'
        `;
        const params = [];
        
        if (year) {
            params.push(year);
            query += ` AND EXTRACT(YEAR FROM r.start_date) = $${params.length}`;
        }
        if (month) {
            params.push(month);
            query += ` AND EXTRACT(MONTH FROM r.start_date) = $${params.length}`;
        }
        query += ` GROUP BY DATE_TRUNC('month', r.start_date) ORDER BY month DESC`;
        
        const result = await pool.query(query, params);
        
        const workbook = new ExcelJS.Workbook();
        const worksheet = workbook.addWorksheet('Financial Report');
        
        worksheet.columns = [
            { header: 'Month', key: 'month', width: 15 },
            { header: 'Rental Count', key: 'rental_count', width: 15 },
            { header: 'Total Revenue', key: 'total_revenue', width: 18 },
            { header: 'Total Internal Cost', key: 'total_internal_cost', width: 18 },
            { header: 'Net Profit', key: 'net_profit', width: 18 }
        ];
        
        result.rows.forEach(row => {
            const netProfit = (parseFloat(row.total_revenue) || 0) - (parseFloat(row.total_internal_cost) || 0);
            worksheet.addRow({
                month: row.month ? new Date(row.month).toLocaleDateString('en-US', { year: 'numeric', month: 'long' }) : '-',
                rental_count: row.rental_count,
                total_revenue: parseFloat(row.total_revenue) || 0,
                total_internal_cost: parseFloat(row.total_internal_cost) || 0,
                net_profit: netProfit
            });
        });
        
        const totalRevenue = result.rows.reduce((sum, r) => sum + (parseFloat(r.total_revenue) || 0), 0);
        const totalCost = result.rows.reduce((sum, r) => sum + (parseFloat(r.total_internal_cost) || 0), 0);
        const netProfit = totalRevenue - totalCost;
        
        worksheet.addRow({});
        worksheet.addRow({ month: 'TOTAL REVENUE', total_revenue: totalRevenue });
        worksheet.addRow({ month: 'TOTAL INTERNAL COST', total_internal_cost: totalCost });
        worksheet.addRow({ month: 'NET PROFIT', net_profit: netProfit });
        
        res.setHeader('Content-Type', 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet');
        res.setHeader('Content-Disposition', 'attachment; filename=financial_report.xlsx');
        
        await workbook.xlsx.write(res);
        res.end();
    } catch (err) {
        console.error('Financial report error:', err);
        res.status(500).json({ error: err.message });
    }
});

console.log('✅ Reports endpoints added');

// ============ CHARTS DATA ============

// Get monthly rentals data for charts
app.get('/api/charts/rentals-by-month', async (req, res) => {
    const { year } = req.query;
    const currentYear = year || new Date().getFullYear();
    
    try {
        const result = await pool.query(`
            SELECT 
                EXTRACT(MONTH FROM start_date) as month,
                COUNT(*) as rental_count,
                COALESCE(SUM(subtotal), 0) as total_revenue
            FROM rentals
            WHERE EXTRACT(YEAR FROM start_date) = $1 AND status != 'cancelled'
            GROUP BY EXTRACT(MONTH FROM start_date)
            ORDER BY month ASC
        `, [currentYear]);
        
        // Fill missing months with zeros
        const monthlyData = Array(12).fill(0);
        const revenueData = Array(12).fill(0);
        
        result.rows.forEach(row => {
            const monthIndex = parseInt(row.month) - 1;
            monthlyData[monthIndex] = parseInt(row.rental_count);
            revenueData[monthIndex] = parseFloat(row.total_revenue);
        });
        
        res.json({
            year: currentYear,
            months: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'],
            rentals: monthlyData,
            revenue: revenueData
        });
    } catch (err) {
        res.status(500).json({ error: err.message });
    }
});

// Get work orders status distribution
app.get('/api/charts/workorders-status', async (req, res) => {
    try {
        const result = await pool.query(`
            SELECT 
                status,
                COUNT(*) as count
            FROM work_orders
            GROUP BY status
        `);
        
        const statusMap = {
            'pending': 0,
            'in_progress': 0,
            'completed': 0
        };
        
        result.rows.forEach(row => {
            if (statusMap.hasOwnProperty(row.status)) {
                statusMap[row.status] = parseInt(row.count);
            }
        });
        
        res.json({
            labels: ['Pending', 'In Progress', 'Completed'],
            data: [statusMap.pending, statusMap.in_progress, statusMap.completed]
        });
    } catch (err) {
        res.status(500).json({ error: err.message });
    }
});

// Get low stock items count
app.get('/api/charts/low-stock', async (req, res) => {
    try {
        const result = await pool.query(`
            SELECT COUNT(*) as count
            FROM spare_parts
            WHERE stock_quantity <= min_stock
        `);
        
        const totalResult = await pool.query(`
            SELECT COUNT(*) as total
            FROM spare_parts
        `);
        
        res.json({
            low_stock: parseInt(result.rows[0].count),
            total_parts: parseInt(totalResult.rows[0].total)
        });
    } catch (err) {
        res.status(500).json({ error: err.message });
    }
});

