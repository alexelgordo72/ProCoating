// Update spare part
app.put('/api/spare-parts/:id', async (req, res) => {
    const { id } = req.params;
    const { part_number, name, description, category, location, stock_quantity, min_stock, max_stock, unit_price } = req.body;
    try {
        const result = await pool.query(
            `UPDATE spare_parts 
             SET part_number = COALESCE($1, part_number),
                 name = COALESCE($2, name),
                 description = COALESCE($3, description),
                 category = COALESCE($4, category),
                 location = COALESCE($5, location),
                 stock_quantity = COALESCE($6, stock_quantity),
                 min_stock = COALESCE($7, min_stock),
                 max_stock = COALESCE($8, max_stock),
                 unit_price = COALESCE($9, unit_price)
             WHERE id = $10 RETURNING *`,
            [part_number, name, description, category, location, stock_quantity, min_stock, max_stock, unit_price, id]
        );
        res.json(result.rows[0]);
    } catch (err) {
        res.status(500).json({ error: err.message });
    }
});

