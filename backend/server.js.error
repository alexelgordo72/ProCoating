// ============ AUDIT LOGS ============
// Función para registrar acciones
async function logAction(userId, username, action, entityType, entityId, details, req = null) {
    try {
        let ipAddress = null;
        let userAgent = null;
        if (req) {
            ipAddress = req.headers['x-forwarded-for'] || req.socket.remoteAddress;
            userAgent = req.headers['user-agent'];
        }
        
        await pool.query(
            `INSERT INTO audit_logs (user_id, username, action, entity_type, entity_id, details, ip_address, user_agent)
             VALUES ($1, $2, $3, $4, $5, $6, $7, $8)`,
            [userId, username, action, entityType, entityId, details, ipAddress, userAgent]
        );
    } catch (err) {
        console.error('Error logging action:', err);
    }
}

// Middleware para loggear acciones automáticamente
app.use(async (req, res, next) => {
    const originalSend = res.send;
    res.send = function(data) {
        originalSend.call(this, data);
    };
    next();
});

// Endpoints de auditoría
app.get('/api/audit-logs', async (req, res) => {
    const { limit = 100, offset = 0, action, entity_type, start_date, end_date } = req.query;
    try {
        let query = `SELECT al.*, u.username as user_name 
                     FROM audit_logs al
                     LEFT JOIN users u ON al.user_id = u.id
                     WHERE 1=1`;
        const params = [];
        
        if (action) {
            params.push(action);
            query += ` AND al.action = $${params.length}`;
        }
        if (entity_type) {
            params.push(entity_type);
            query += ` AND al.entity_type = $${params.length}`;
        }
        if (start_date) {
            params.push(start_date);
            query += ` AND al.created_at >= $${params.length}`;
        }
        if (end_date) {
            params.push(end_date);
            query += ` AND al.created_at <= $${params.length}`;
        }
        
        query += ` ORDER BY al.id DESC LIMIT $${params.length + 1} OFFSET $${params.length + 2}`;
        params.push(parseInt(limit), parseInt(offset));
        
        const result = await pool.query(query, params);
        res.json(result.rows);
    } catch (err) {
        res.status(500).json({ error: err.message });
    }
});

app.get('/api/audit-logs/count', async (req, res) => {
    const { action, entity_type, start_date, end_date } = req.query;
    try {
        let query = `SELECT COUNT(*) FROM audit_logs WHERE 1=1`;
        const params = [];
        
        if (action) {
            params.push(action);
            query += ` AND action = $${params.length}`;
        }
        if (entity_type) {
            params.push(entity_type);
            query += ` AND entity_type = $${params.length}`;
        }
        if (start_date) {
            params.push(start_date);
            query += ` AND created_at >= $${params.length}`;
        }
        if (end_date) {
            params.push(end_date);
            query += ` AND created_at <= $${params.length}`;
        }
        
        const result = await pool.query(query, params);
        res.json({ count: parseInt(result.rows[0].count) });
    } catch (err) {
        res.status(500).json({ error: err.message });
    }
});

app.get('/api/audit-logs/actions', async (req, res) => {
    try {
        const result = await pool.query('SELECT DISTINCT action FROM audit_logs ORDER BY action');
        res.json(result.rows.map(r => r.action));
    } catch (err) {
        res.status(500).json({ error: err.message });
    }
});

app.get('/api/audit-logs/entities', async (req, res) => {
    try {
        const result = await pool.query('SELECT DISTINCT entity_type FROM audit_logs WHERE entity_type IS NOT NULL ORDER BY entity_type');
        res.json(result.rows.map(r => r.entity_type));
    } catch (err) {
        res.status(500).json({ error: err.message });
    }
});

console.log('✅ Audit Logs endpoints added');

// Modificar endpoints para agregar logs (ejemplos)
// Customers - POST
const originalCustomersPost = app.post.bind(app, '/api/customers');
app.post('/api/customers', async (req, res) => {
    const token = req.cookies.token;
    let userId = null, username = 'anonymous';
    if (token) {
        try {
            const decoded = jwt.verify(token, JWT_SECRET);
            userId = decoded.id;
            username = decoded.username;
        } catch(e) {}
    }
    
    const result = await pool.query(
        'INSERT INTO customers (name, phone, email, address) VALUES ($1,$2,$3,$4) RETURNING *',
        [req.body.name, req.body.phone, req.body.email, req.body.address]
    );
    
    await logAction(userId, username, 'create', 'customer', result.rows[0].id, 
                   `Created customer: ${req.body.name}`, req);
    res.json(result.rows[0]);
});

// Customers - DELETE
const originalCustomersDelete = app.delete.bind(app, '/api/customers/:id');
app.delete('/api/customers/:id', async (req, res) => {
    const token = req.cookies.token;
    let userId = null, username = 'anonymous';
    if (token) {
        try {
            const decoded = jwt.verify(token, JWT_SECRET);
            userId = decoded.id;
            username = decoded.username;
        } catch(e) {}
    }
    
    const customerResult = await pool.query('SELECT name FROM customers WHERE id = $1', [req.params.id]);
    const customerName = customerResult.rows[0]?.name || 'Unknown';
    
    await pool.query('DELETE FROM customers WHERE id = $1', [req.params.id]);
    
    await logAction(userId, username, 'delete', 'customer', parseInt(req.params.id), 
                   `Deleted customer: ${customerName}`, req);
    res.json({ success: true });
});

// Rentals - POST
const originalRentalsPost = app.post.bind(app, '/api/rentals');
app.post('/api/rentals', async (req, res) => {
    const token = req.cookies.token;
    let userId = null, username = 'anonymous';
    if (token) {
        try {
            const decoded = jwt.verify(token, JWT_SECRET);
            userId = decoded.id;
            username = decoded.username;
        } catch(e) {}
    }
    
    const start = new Date(req.body.start_date);
    const end = req.body.end_date ? new Date(req.body.end_date) : null;
    const total_days = end ? Math.ceil((end - start) / (1000*60*60*24)) : 1;
    const equipRes = await pool.query('SELECT daily_rate FROM equipment WHERE id = $1', [req.body.equipment_id]);
    const daily_rate = equipRes.rows[0]?.daily_rate || 0;
    const subtotal = daily_rate * total_days;
    
    const result = await pool.query(
        `INSERT INTO rentals (rental_number, customer_id, equipment_id, start_date, end_date, total_days, subtotal, notes, status)
         VALUES ($1,$2,$3,$4,$5,$6,$7,$8,'active') RETURNING *`,
        [req.body.rental_number, req.body.customer_id, req.body.equipment_id, req.body.start_date, 
         req.body.end_date, total_days, subtotal, req.body.notes]
    );
    
    await logAction(userId, username, 'create', 'rental', result.rows[0].id, 
                   `Created rental ${req.body.rental_number}`, req);
    res.json(result.rows[0]);
});

// Work Orders - POST
const originalWorkOrdersPost = app.post.bind(app, '/api/workorders');
app.post('/api/workorders', async (req, res) => {
