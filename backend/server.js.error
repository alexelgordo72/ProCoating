                   `Created work order ${req.body.wo_number}`, req);
    res.json(result.rows[0]);
});

// Login - agregar log
const originalLogin = app.post.bind(app, '/api/auth/login');
app.post('/api/auth/login', async (req, res) => {
    const { username, password } = req.body;
    const result = await pool.query('SELECT * FROM users WHERE username = $1', [username]);
    if (result.rows.length === 0) return res.status(401).json({ error: 'Invalid credentials' });
    
    const user = result.rows[0];
    const hash = crypto.createHash('md5').update(password).digest('hex');
    if (user.password !== hash) return res.status(401).json({ error: 'Invalid credentials' });
    
    const token = jwt.sign({ id: user.id, username: user.username }, JWT_SECRET, { expiresIn: '24h' });
    res.cookie('token', token, { httpOnly: true, maxAge: 24 * 60 * 60 * 1000 });
    
    await logAction(user.id, user.username, 'login', 'auth', user.id, 'User ' + username + ' logged in', req);
                   `User ${username} logged in`, req);
    
    res.json({ success: true, user: { id: user.id, username: user.username } });
});

// Logout
const originalLogout = app.post.bind(app, '/api/auth/logout');
app.post('/api/auth/logout', async (req, res) => {
    const token = req.cookies.token;
    if (token) {
        try {
            const decoded = jwt.verify(token, JWT_SECRET);
            await logAction(decoded.id, decoded.username, 'logout', 'auth', decoded.id, 
                           `User ${decoded.username} logged out`, req);
        } catch(e) {}
    }
    res.clearCookie('token');
    res.json({ success: true });
});

console.log('✅ Audit logging integrated into endpoints');

// Función mejorada para obtener IP real
function getClientIp(req) {
    return req.headers['x-forwarded-for']?.split(',')[0] || 
           req.headers['x-real-ip'] || 
           req.socket.remoteAddress || 
           'unknown';
}

// Middleware para loggear todas las peticiones API
app.use('/api/*', (req, res, next) => {
    const originalJson = res.json;
    res.json = function(data) {
        // Solo loggear operaciones de escritura (POST, PUT, DELETE)
        if (['POST', 'PUT', 'DELETE'].includes(req.method)) {
            const token = req.cookies.token;
            let userId = null, username = 'anonymous';
            if (token) {
                try {
                    const decoded = jwt.verify(token, JWT_SECRET);
                    userId = decoded.id;
                    username = decoded.username;
                } catch(e) {}
            }
            const ip = getClientIp(req);
            const action = `${req.method} ${req.path}`;
            logAction(userId, username, action, 'api', null, 
                     `Request to ${req.path}`, req);
        }
        originalJson.call(this, data);
    };
    next();
});
