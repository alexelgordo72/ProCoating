    let userId = null, username = 'anonymous';
    if (token) {
        try {
            const decoded = jwt.verify(token, JWT_SECRET);
            userId = decoded.id;
            username = decoded.username;
        } catch(e) {}
    }
    
    const result = await pool.query(
        `INSERT INTO work_orders (wo_number, customer_id, equipment_id, priority, reported_issue, is_warranty, status)
         VALUES ($1,$2,$3,$4,$5,$6,'pending') RETURNING *`,
        [req.body.wo_number, req.body.customer_id, req.body.equipment_id, 
         req.body.priority || 'normal', req.body.reported_issue, req.body.is_warranty || false]
