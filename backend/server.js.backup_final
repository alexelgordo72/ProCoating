// ============ PURCHASE ORDERS ============
app.get('/api/purchase-orders', async (req, res) => {
    const result = await pool.query(`
        SELECT po.*, s.name as supplier_name
        FROM purchase_orders po
        LEFT JOIN suppliers s ON po.supplier_id = s.id
        ORDER BY po.id DESC
    `);
    res.json(result.rows);
});

// ============ PDF ============
app.get('/api/rentals/:id/pdf', async (req, res) => {
    const { id } = req.params;
    const result = await pool.query(`
        SELECT r.*, c.name as customer_name, e.model as equipment_model, e.tons
        FROM rentals r
        JOIN customers c ON r.customer_id = c.id
        JOIN equipment e ON r.equipment_id = e.id
        WHERE r.id = $1
    `, [id]);
    
    if (result.rows.length === 0) return res.status(404).send('Not found');
    const r = result.rows[0];
    const html = `<!DOCTYPE html>
<html>
<head><meta charset="UTF-8"><title>Delivery ${r.rental_number}</title>
<style>
body { font-family: Arial; margin: 40px; }
.header { text-align: center; }
.company { font-size: 24px; font-weight: bold; color: #0a2b4e; }
</style>
</head>
<body>
<div class="header">
<div class="company">Pro-Coating Treatments Inc.</div>
<div>1498 Camino Los Gonzalez Apt 3, San Juan, PR 00926-8802</div>
<div>Tel (787) 604-4347 / (787) 309-8738</div>
</div>
<h2 style="text-align:center;">RENTAL EQUIPMENT DELIVERY</h2>
<p><strong>Customer:</strong> ${r.customer_name}</p>
<p><strong>Delivery #:</strong> ${r.rental_number}</p>
<p><strong>Date:</strong> ${new Date(r.start_date).toLocaleDateString()}</p>
<p><strong>Equipment:</strong> ${r.equipment_model} (${r.tons} Tons)</p>
<p><strong>Total:</strong> $${r.subtotal}</p>
<div style="margin-top:50px;">
<div style="float:left;width:45%;">Customer Signature: _________________</div>
<div style="float:right;width:45%;">ProCoating Rep: _________________</div>
</div>
</body>
</html>`;
    res.setHeader('Content-Type', 'text/html');
    res.send(html);
});

// Start server
app.get("/health", (req, res) => {
app.get("/login.html", (req, res) => { res.sendFile("/var/www/procoating/login.html"); });
    res.json({ status: "OK", message: "API running" });
});
app.listen(PORT, '0.0.0.0', () => {
    console.log(`✅ Server running on http://0.0.0.0:${PORT}`);
});

