app.post('/api/workorders', async (req, res) => {
    const { wo_number, customer_id, equipment_id, employee_id, vehicle_id, priority, reported_issue, is_warranty } = req.body;
    try {
        const result = await pool.query(
            `INSERT INTO work_orders (wo_number, customer_id, equipment_id, employee_id, vehicle_id, priority, reported_issue, is_warranty, status)
             VALUES ($1, $2, $3, $4, $5, $6, $7, $8, 'pending') RETURNING *`,
            [wo_number, customer_id, equipment_id, employee_id, vehicle_id, priority || 'normal', reported_issue, is_warranty || false]
        );
        res.json(result.rows[0]);
    } catch (err) {
        res.status(500).json({ error: err.message });
    }
});

