app.get('/api/equipment', async (req, res) => {
    try {
        const result = await pool.query('SELECT * FROM equipment ORDER BY id');
        res.json(result.rows);
    } catch (err) {
        res.status(500).json({ error: err.message });
    }
});

// ============ RENTALS ============
app.get('/api/rentals', async (req, res) => {
    try {
        const result = await pool.query(`
            SELECT r.*, c.name as customer_name, e.model as equipment_model 
            FROM rentals r
            JOIN customers c ON r.customer_id = c.id
            JOIN equipment e ON r.equipment_id = e.id
            ORDER BY r.id DESC
        `);
        res.json(result.rows);
    } catch (err) {
        res.status(500).json({ error: err.message });
    }
});

app.post('/api/rentals', async (req, res) => {
    const { rental_number, customer_id, equipment_id, start_date, end_date, delivery_date, notes } = req.body;
    
    const start = new Date(start_date);
    const end = end_date ? new Date(end_date) : null;
    const total_days = end ? Math.ceil((end - start) / (1000 * 60 * 60 * 24)) : 1;
    
    try {
        const equipmentResult = await pool.query('SELECT daily_rate FROM equipment WHERE id = $1', [equipment_id]);
        const equipmentRate = equipmentResult.rows[0]?.daily_rate || 0;
        const subtotal = equipmentRate * total_days;
        
        const result = await pool.query(
            `INSERT INTO rentals (rental_number, customer_id, equipment_id, start_date, end_date, delivery_date, total_days, subtotal, notes, status)
             VALUES ($1, $2, $3, $4, $5, $6, $7, $8, $9, 'active') RETURNING *`,
            [rental_number, customer_id, equipment_id, start_date, end_date, delivery_date, total_days, subtotal, notes]
        );
        res.json({ success: true, rental: result.rows[0] });
    } catch (err) {
        res.status(500).json({ error: err.message });
    }
});

