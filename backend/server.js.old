// ============ PDF GENERATION ============
app.get('/api/rentals/:id/pdf', async (req, res) => {
    const { id } = req.params;
    try {
        const result = await pool.query(`
            SELECT r.*, c.name as customer_name, e.model as equipment_model, e.tons, e.btu_h
            FROM rentals r
            JOIN customers c ON r.customer_id = c.id
            JOIN equipment e ON r.equipment_id = e.id
            WHERE r.id = $1
        `, [id]);
        
        if (result.rows.length === 0) {
            return res.status(404).send('Rental not found');
        }
        
        const r = result.rows[0];
        const html = `<!DOCTYPE html>
<html>
<head><meta charset="UTF-8"><title>Delivery ${r.rental_number}</title>
<style>
body { font-family: Arial, sans-serif; margin: 40px; }
.header { text-align: center; margin-bottom: 30px; }
.company { font-size: 24px; font-weight: bold; color: #0a2b4e; }
.sub { font-size: 12px; color: #666; }
.title { font-size: 20px; font-weight: bold; text-align: center; margin: 20px 0; }
.row { display: flex; margin-bottom: 10px; }
.label { font-weight: bold; width: 180px; }
table { width: 100%; border-collapse: collapse; margin: 20px 0; }
th, td { border: 1px solid #ddd; padding: 8px; text-align: left; }
th { background: #f0f0f0; }
.signatures { display: flex; margin-top: 50px; gap: 40px; }
.signature { flex: 1; }
.footer { text-align: center; margin-top: 50px; font-size: 11px; color: #666; }
</style>
</head>
<body>
<div class="header">
<div class="company">Pro-Coating Treatments Inc.</div>
<div class="sub">1498 Camino Los Gonz\u00e1lez Apt 3, San Juan, PR 00926-8802</div>
<div class="sub">Tel (787) 604-4347 / (787) 309-8738 | Fax (787) 293-4256</div>
<div class="sub">www.procoatingpr.com</div>
</div>
<div class="title">RENTAL EQUIPMENT DELIVERY</div>
<div class="row"><div class="label">CUSTOMER NAME:</div><div>${r.customer_name}</div></div>
<div class="row"><div class="label">DATE:</div><div>${new Date(r.delivery_date || r.start_date).toLocaleDateString()}</div></div>
<div class="row"><div class="label">DELIVERY #:</div><div>${r.rental_number}</div></div>
<div class="row"><div class="label">PROJECT:</div><div>${r.notes ? r.notes.split('\n')[0] : '—'}</div></div>
<table>
<thead><tr><th>QTY</th><th>DESCRIPTION</th><th>NOTES</th></tr></thead>
<tbody><tr><td>1</td><td>${r.equipment_model} (${r.tons} Tons / ${r.btu_h?.toLocaleString()} BTU/h)</td><td></td></tr></tbody>
</table>
<div class="row"><div class="label">START DATE:</div><div>${new Date(r.start_date).toLocaleDateString()}</div></div>
<div class="row"><div class="label">END DATE:</div><div>${r.end_date ? new Date(r.end_date).toLocaleDateString() : '—'}</div></div>
<div class="row"><div class="label">TOTAL DAYS:</div><div>${r.total_days || '—'}</div></div>
${r.notes ? `<div class="row"><div class="label">NOTES:</div><div>${r.notes}</div></div>` : ''}
<div class="signatures">
<div class="signature">CUSTOMER (NAME)<br><br>_________________________<br><span style="font-size:10px;">CLIENTE (NOMBRE EN LETRA DE MOLDE)</span></div>
<div class="signature">PRO-COATING REP<br><br>_________________________<br><span style="font-size:10px;">SIGNATURE / FIRMA</span></div>
</div>
<div class="footer">Thank you for choosing Pro-Coating Treatments Inc.</div>
</body>
</html>`;
        
        res.setHeader('Content-Type', 'text/html');
        res.send(html);
    } catch (err) {
        res.status(500).json({ error: err.message });
    }
});

