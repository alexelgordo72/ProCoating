// ============ WORK ORDERS - COMPLETAR ============

// Get single work order with photos and costs
app.get('/api/workorders/:id', async (req, res) => {
    const { id } = req.params;
    try {
        const woResult = await pool.query(`
            SELECT wo.*, c.name as customer_name, c.phone, c.address,
                   e.model as equipment_model, e.tons, e.serial_number,
                   emp.name as employee_name, v.plate as vehicle_plate
            FROM work_orders wo
            LEFT JOIN customers c ON wo.customer_id = c.id
            LEFT JOIN equipment e ON wo.equipment_id = e.id
            LEFT JOIN employees emp ON wo.employee_id = emp.id
            LEFT JOIN vehicles v ON wo.vehicle_id = v.id
            WHERE wo.id = $1
        `, [id]);
        
        const photosResult = await pool.query(
            'SELECT * FROM work_order_photos WHERE work_order_id = $1 ORDER BY id DESC',
            [id]
        );
        
        const costsResult = await pool.query(
            'SELECT * FROM work_order_costs WHERE work_order_id = $1 ORDER BY id',
            [id]
        );
        
        res.json({
            work_order: woResult.rows[0],
            photos: photosResult.rows,
            costs: costsResult.rows
        });
    } catch (err) {
        res.status(500).json({ error: err.message });
    }
});

// Update work order status and details
app.put('/api/workorders/:id', async (req, res) => {
    const { id } = req.params;
    const { status, end_date, diagnosis, solution, internal_cost, employee_id, vehicle_id } = req.body;
    try {
        const result = await pool.query(
            `UPDATE work_orders 
             SET status = COALESCE($1, status),
                 end_date = COALESCE($2, end_date),
                 diagnosis = COALESCE($3, diagnosis),
                 solution = COALESCE($4, solution),
                 internal_cost = COALESCE($5, internal_cost),
                 employee_id = COALESCE($6, employee_id),
                 vehicle_id = COALESCE($7, vehicle_id)
             WHERE id = $8 RETURNING *`,
            [status, end_date, diagnosis, solution, internal_cost, employee_id, vehicle_id, id]
        );
        res.json(result.rows[0]);
    } catch (err) {
        res.status(500).json({ error: err.message });
    }
});

// Upload photo to work order
app.post('/api/workorders/:id/photos', upload.single('photo'), async (req, res) => {
    const { id } = req.params;
    const image_url = `/uploads/${req.file.filename}`;
    const { description } = req.body;
    
    try {
        const result = await pool.query(
            'INSERT INTO work_order_photos (work_order_id, image_url, description) VALUES ($1, $2, $3) RETURNING *',
            [id, image_url, description || '']
        );
        res.json(result.rows[0]);
    } catch (err) {
        res.status(500).json({ error: err.message });
    }
});

// Add cost to work order
app.post('/api/workorders/:id/costs', async (req, res) => {
    const { id } = req.params;
    const { description, amount } = req.body;
    try {
        const result = await pool.query(
            'INSERT INTO work_order_costs (work_order_id, description, amount) VALUES ($1, $2, $3) RETURNING *',
            [id, description, amount]
        );
        
        // Update total internal cost
        await pool.query(
            'UPDATE work_orders SET internal_cost = internal_cost + $1 WHERE id = $2',
            [amount, id]
        );
        
        res.json(result.rows[0]);
    } catch (err) {
        res.status(500).json({ error: err.message });
    }
});

// Delete photo from work order
app.delete('/api/workorders/photos/:id', async (req, res) => {
    const { id } = req.params;
    try {
        await pool.query('DELETE FROM work_order_photos WHERE id = $1', [id]);
        res.json({ success: true });
    } catch (err) {
        res.status(500).json({ error: err.message });
    }
});

